rules_version = '2';

// ゆうちゃっと Firestore セキュリティルール
//
// もとのルール（Firebase Console に公開中のもの）：
//   match /{document=**} { allow read, write: if request.auth != null; }
// を土台にして、管理者用のデータ（手動レース・お知らせ）だけを守るように変えている。
// それ以外のコレクション（users / friends / groups / messages / gameRooms / gameInvites /
// races / raceBets / raceLogs / fcmTokens など）は、もとのルールと同じ「ログイン済みなら読み書き可」のまま。
//
// derby-runner（GitHub Actions）と通知の Worker はサービスアカウントで書き込むので、このルールの影響を受けない。
//
// 株価（market）と総資産ランキング（rankings）は、毎日 13:00 に derby-runner だけが書く。
// ブラウザからは読み取りだけ（書き換えて株価やランキングを操作できないように）。
//
// イベント機能（events / eventParticipants）は廃止した。Firestore に残っている過去のデータは消さずに残すが、
// ブラウザからは読み取りも書き込みもできない（管理者も含む）。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ログイン中のユーザーのユーザー名。通知サーバー（Cloudflare Worker）がログイン時にトークンの
    // カスタムクレーム name に本人のユーザー名を入れる（users/{名前}.uid == 本人 を確かめたうえで）。
    // チャットやグループは「名前」で相手を特定しているので、トークンの名前と突き合わせて本人確認する。
    // クレームが無い（まだ同期していない）ときは '' を返す。
    function myName() {
      return signedIn() ? request.auth.token.get('name', '') : '';
    }

    // 管理者は Firebase Authentication の UID だけで判定する（メールアドレスやユーザー名は使わない）
    function isAdmin() {
      return signedIn() && request.auth.uid == 'g51wzTvJFsZiYEfre5aDuDckJXY2';
    }

    // 下のコレクションは、このあとの専用のルールだけで書き込みを判定する
    function isAdminManagedCollection(collection) {
      return collection in ['derbyManualRaces', 'announcements'];
    }

    // 廃止した機能のコレクション。ブラウザからは読み取りも書き込みもできない
    function isRetiredCollection(collection) {
      return collection in ['events', 'eventParticipants'];
    }

    // 下のコレクションは、このあとの専用のルールで書き込みを判定する（今までの「ログイン済みなら書ける」をもとに、一部だけ絞る）
    //   users：自分のデータだけ（管理者による名前の強制変更を除く）／adminNameChanges：管理者の名前変更の記録
    //   friends：友達関係の解除（削除）は当事者だけ
    //   第2段階（チャット・通知）：messages（本人だけ）／groups（メンバーだけ）／fcmTokens（本人の UID だけ）
    //   第3段階（ゲーム・ユーザー作成）：gameRooms・gameInvites・gameRoomOwners（参加者・当事者だけ）
    function hasDedicatedWriteRules(collection) {
      return collection in ['users', 'adminNameChanges', 'friends',
        'messages', 'groups', 'fcmTokens', 'gameRooms', 'gameInvites', 'gameRoomOwners'];
    }

    // 下のコレクションは、読み取りも専用のルールで判定する（もとの「ログイン済みなら誰でも読める」から外す）。
    //   messages・groups：当事者／メンバーだけ（他人のチャットを読めないように）
    //   gameInvites：送った人・送られた人だけ／fcmTokens：アプリからは読まない（通知サーバーだけが読む）
    //   gameRooms・gameRoomOwners：専用のルールで判定（gameRooms はロビー表示のため読み取りは今まで通り許可）
    function hasDedicatedReadRules(collection) {
      return collection in ['messages', 'groups', 'fcmTokens', 'gameInvites', 'gameRooms', 'gameRoomOwners', 'yuslotSeats', 'lotteryEntries', 'lotteryRounds'];
    }

    // 下のコレクションは管理者だけが読める
    //   adminAuditLogs：👤 ユーザー管理の操作の記録／userDeletions：完全削除の進み具合／suspendedUsers：停止中のユーザー
    //   notificationLogs：プッシュ通知の送信記録（アプリは読まないので、専用の読み取りルールは作らない＝管理者も含めてブラウザからは読めない）
    function isAdminOnlyReadCollection(collection) {
      return collection in ['adminNameChanges', 'adminAuditLogs', 'userDeletions', 'suspendedUsers', 'notificationLogs'];
    }

    // 下のコレクションは自動処理（サービスアカウント）だけが書く。ブラウザからは書き込めない
    //   adminAuditLogs・userDeletions・suspendedUsers は、管理者の操作を受けた通知サーバー（Cloudflare Worker）だけが書く
    //   notificationLogs は通知の二重送信防止の記録。Worker（と同じ処理を使う GitHub Actions）だけが書く
    //   （ブラウザから先に作られると、ゆうダービーやお知らせの通知が止められてしまうため）
    function isServerOnlyCollection(collection) {
      return collection in ['market', 'rankings', 'adminAuditLogs', 'userDeletions', 'suspendedUsers', 'notificationLogs',
        // レース結果・開催ログ・馬券は、サーバー（通知 Worker・GitHub Actions の derby-runner）だけが書く。ブラウザからは読み取りだけ
        'races', 'raceLogs', 'raceBets',
        // 🎰 ゆうワールド：公開設定と着席は通知 Worker（サービスアカウント）だけが書く。ブラウザからは書けない
        //   worldConfig：公開/非公開（最上位管理者の操作を受けて Worker が書く）／yuslotSeats：着席の予約・解放は Worker だけ
        'worldConfig', 'yuslotSeats',
        // 🎟 ゆう宝くじ売り場：購入枚数（lotteryEntries）と抽選結果（lotteryRounds）は通知 Worker（サービスアカウント）だけが書く
        'lotteryEntries', 'lotteryRounds'];
    }

    // ===== もとのルール（管理者用・自動処理用・廃止したコレクション・専用ルールのあるコレクション以外は今まで通り） =====
    match /{collection}/{document=**} {
      allow read: if signedIn() && !isRetiredCollection(collection) && !isAdminOnlyReadCollection(collection) && !hasDedicatedReadRules(collection);
      allow write: if signedIn() && !isAdminManagedCollection(collection) && !isServerOnlyCollection(collection) && !isRetiredCollection(collection) && !hasDedicatedWriteRules(collection);
    }

    // ===== 手動ゆうダービー（derbyManualRaces/{raceId}） =====
    // 読み取り：ログイン済みなら誰でも（レース表示・投票受付の判定に使う）
    // 作成・キャンセル・削除：管理者だけ
    // 一般ユーザー：投票と同じトランザクションで betCount を 1 増やすことだけ
    //   （キャンセルされていない・投票受付時間内のレースだけ）
    match /derbyManualRaces/{raceId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // 投票数（betCount）の加算は通知 Worker（サービスアカウント）が行う。ブラウザからは作成・キャンセル・削除は管理者だけ、更新はできない
      allow update: if isAdmin();
    }

    // ===== ゆうダービーの馬券（raceBets/{betId}） =====
    // 購入・精算は通知 Worker（サービスアカウント）が行う（残高・締切・オッズ・払い戻し額をサーバーで確かめる）。
    // ブラウザからは読み取りだけ（購入・改変・削除・精算はできない。isServerOnlyCollection に含めてある）。
    match /raceBets/{betId} {
      allow read: if signedIn();
    }

    // ===== お知らせ（announcements/{announcementId}） =====
    // 読み取り：ログイン済みなら誰でも
    // 作成・編集・削除：管理者だけ（項目・文字数・作成日時と作成者は書き換えられないことも確かめる）
    // 未読の管理は users/{名前}.lastAnnouncementReadAt（users は今まで通りのルール）。お知らせ側には書かない
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && isValidAnnouncement(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAdmin()
        && isValidAnnouncement(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();

      function isValidAnnouncement(data) {
        return data.keys().hasOnly(['title', 'body', 'createdAt', 'updatedAt', 'createdByUid', 'createdByName'])
          && data.keys().hasAll(['title', 'body', 'createdAt', 'updatedAt', 'createdByUid', 'createdByName'])
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 50
          && data.body is string && data.body.size() >= 1 && data.body.size() <= 500
          && data.createdByUid is string
          && data.createdByName is string && data.createdByName.size() <= 100
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }
    }

    // ===== ユーザー（users/{userName}。ドキュメントIDはユーザー名） =====
    // 読み取り：ログイン済みなら誰でも（今まで通り。友達追加・ランキング・通知などで使う）
    // 作成・更新・削除：自分のデータ（uid が自分）だけ。他人の users は書き換えられない
    //   （名前変更・コイン・銀行・株・ログインボーナス・通知設定など、アプリが書くのはすべて自分のデータ）
    // 管理者による名前の強制変更だけ例外：
    //   新しい名前のドキュメントの作成は「古い名前のドキュメントと同じ内容 ＋ 名前と記録用の項目」だけで、
    //   同時に古い名前のドキュメントを消し、adminNameChanges に記録する場合に限る（コインなど他の項目は変えられない）
    match /users/{userName} {
      allow read: if signedIn();
      // 作成：自分の uid のデータだけ（管理者の名前強制変更を除く）。経済項目（コイン・銀行・株など）はブラウザから入れられない
      //   （初期コインは Worker が付ける。経済項目を入れた新規作成は拒否する）
      //   さらに name 項目はドキュメントID（ユーザー名）と一致していなければならない（他人の名前の横取り・なりすましを防ぐ）。
      //   登録直後はまだトークンのクレームが無いので、作成では名前クレームの一致は求めない（クレームは作成後に Worker が付ける）。
      allow create: if signedIn()
        && ((request.resource.data.get('uid', '') == request.auth.uid
              && request.resource.data.get('name', userName) == userName
              && !hasEconomyFields(request.resource.data))
            || isAdminRenameCreate());
      // 更新：自分のデータ（uid が自分）だけ。他人の users は書き換えられない（isOwnUserDoc で所有を確認）。
      //   経済項目は1つも変えられない（コイン・銀行・株・累計賭け金・ボーナス・ログインボーナスは Worker だけが変える）。
      allow update: if signedIn() && isOwnUserDoc() && request.resource.data.get('uid', '') == request.auth.uid
        && !economyFieldsChanged();
      // 削除：自分のデータだけ（名前変更の引き継ぎは Worker が消す。管理者の名前強制変更は別の条件）
      allow delete: if signedIn() && (isOwnUserDoc() || isAdminRenameDelete());

      function isOwnUserDoc() {
        return resource.data.get('uid', '') == request.auth.uid;
      }

      // 経済項目（お金に関わる項目）。ブラウザからは作成・変更できない
      function economyFields() {
        return ['coins', 'bank', 'stocks', 'totalBetAmount', 'bonus500Granted', 'bonus500GrantedAt', 'lastLoginBonusDate'];
      }
      function hasEconomyFields(data) {
        return data.keys().hasAny(economyFields());
      }
      function economyFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(economyFields());
      }

      function userPath(name) {
        return /databases/$(database)/documents/users/$(name);
      }

      function isAdminRenameCreate() {
        return isAdmin()
          && request.resource.data.get('nameChangedFrom', '') is string
          && request.resource.data.get('nameChangedFrom', '') != ''
          && request.resource.data.get('nameChangedFrom', '') != userName
          && request.resource.data.get('name', '') == userName
          && request.resource.data.get('nameChangedByAdmin', false) == true
          && request.resource.data.get('nameChangedByUid', '') == request.auth.uid
          && request.resource.data.get('nameChangedAt', null) == request.time
          && exists(userPath(request.resource.data.nameChangedFrom))
          && !existsAfter(userPath(request.resource.data.nameChangedFrom))
          && request.resource.data.diff(get(userPath(request.resource.data.nameChangedFrom)).data).affectedKeys()
               .hasOnly(['name', 'nameChangedByAdmin', 'nameChangedByUid', 'nameChangedAt', 'nameChangedFrom']);
      }

      function isAdminRenameDelete() {
        return isAdmin()
          && existsAfter(/databases/$(database)/documents/adminNameChanges/$(userName))
          && getAfter(/databases/$(database)/documents/adminNameChanges/$(userName)).data.get('changedAt', null) == request.time
          && getAfter(/databases/$(database)/documents/adminNameChanges/$(userName)).data.get('to', '') is string
          && getAfter(/databases/$(database)/documents/adminNameChanges/$(userName)).data.get('to', '') != ''
          && existsAfter(userPath(getAfter(/databases/$(database)/documents/adminNameChanges/$(userName)).data.to))
          && getAfter(userPath(getAfter(/databases/$(database)/documents/adminNameChanges/$(userName)).data.to)).data.get('uid', '') == resource.data.get('uid', '');
      }
    }

    // users の下のデータ（サブコレクション）は今まで通り（{rest=**} は 0 階層にも一致するので、1階層目を {sub} で受ける）
    match /users/{userName}/{sub}/{rest=**} {
      allow read, write: if signedIn();
    }

    // ===== 友達関係（friends/{friendshipId}） =====
    // 作成・更新（友達追加・最新メッセージ・既読・プロフィール画像・名前変更の引き継ぎ）：今まで通りログイン済みなら可
    // 削除（友達関係の解除）：その友達関係の当事者（user1 / user2）だけ。メッセージ（messages）は消さない
    //   当事者かどうかは uid の項目（user1Uid / user2Uid）で判定し、uid の項目が無い古い友達関係は、名前から users の uid を見て判定する
    match /friends/{friendshipId} {
      allow create, update: if signedIn();
      allow delete: if signedIn() && isFriendshipMember(resource.data);

      function isFriendshipMember(data) {
        return data.get('user1Uid', '') == request.auth.uid
          || data.get('user2Uid', '') == request.auth.uid
          || (data.get('user1Uid', '') == '' && isUserNamed(data.get('user1', '')))
          || (data.get('user2Uid', '') == '' && isUserNamed(data.get('user2', '')));
      }

      function isUserNamed(name) {
        return name is string && name != ''
          && exists(/databases/$(database)/documents/users/$(name))
          && get(/databases/$(database)/documents/users/$(name)).data.get('uid', '') == request.auth.uid;
      }
    }

    // ===== 管理者による名前の強制変更の記録（adminNameChanges/{古い名前}） =====
    // 読み取り・書き込み：管理者だけ。users の移動と同じ書き込みの中でだけ作れる
    match /adminNameChanges/{oldName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['from', 'to', 'uid', 'changedByUid', 'changedAt'])
        && request.resource.data.from == oldName
        && request.resource.data.to is string
        && request.resource.data.to != oldName
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.to))
        && !existsAfter(/databases/$(database)/documents/users/$(oldName));
      allow delete: if false;
    }

    // ===== 👤 ユーザー管理の記録：管理者だけが読める。書き込みは通知サーバー（Cloudflare Worker）だけ =====
    //   suspendedUsers：停止中のユーザー（理由・停止した日時）／adminAuditLogs：操作の記録／userDeletions：完全削除の進み具合
    match /suspendedUsers/{uid} {
      allow read: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
    }

    match /userDeletions/{uid} {
      allow read: if isAdmin();
    }

    // ===== 総資産ランキング（rankings/assets）：管理者が名前を強制変更したときだけ、ランキングの名前を書き換えられる =====
    // （自動処理が毎日13:00に作り直す。管理者が変えられるのは users の並びだけで、人数は変えられない）
    match /rankings/{rankingId} {
      allow update: if isAdmin()
        && rankingId == 'assets'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == resource.data.users.size();
    }

    // ============================================================
    // 第2段階：チャット・通知
    // ============================================================

    // ===== グループ（groups/{groupId}） =====
    // 読み取り：そのグループのメンバーだけ（members にユーザー名が入っている人）。他人のグループは読めない
    // 作成：作成者が自分（ownerUid が自分・members に自分が入っている）
    // 更新：管理者（ownerUid）は何でも。メンバーは「最新メッセージ・既読などの更新」か「自分だけの退出」だけ
    // 削除：管理者、または最後の1人（自分だけがメンバー）のとき
    match /groups/{groupId} {
      allow read: if signedIn() && myName() != '' && myName() in resource.data.get('members', []);

      allow create: if signedIn()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && myName() != '' && myName() in request.resource.data.get('members', []);

      allow update: if signedIn() && (
        isGroupOwner(resource.data)
        || (isGroupMember(resource.data) && (memberChatFieldsOnly() || memberSelfLeave()))
      );

      allow delete: if signedIn() && (
        isGroupOwner(resource.data)
        || (myName() != '' && resource.data.get('members', []).hasOnly([myName()]))
      );

      function isGroupOwner(g) {
        return g.get('ownerUid', '') == request.auth.uid
          || (g.get('ownerUid', '') == '' && myName() != '' && g.get('owner', '') == myName());
      }
      function isGroupMember(g) {
        return myName() != '' && myName() in g.get('members', []);
      }
      // メンバーが変えてよいのは、チャットの活動まわりの項目だけ（メンバー構成・名前・管理者は変えない）
      function memberChatFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastMessageSenderUid', 'lastReadAt', 'updatedAt']);
      }
      // 自分だけを members から外す（他の人は増やさない・減らさない）。既読の記録も一緒に消す
      function memberSelfLeave() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastReadAt', 'updatedAt'])
          && myName() in resource.data.get('members', [])
          && !(myName() in request.resource.data.get('members', []))
          && request.resource.data.get('members', []).size() == resource.data.get('members', []).size() - 1
          && resource.data.get('members', []).hasAll(request.resource.data.get('members', []));
      }
    }

    // ===== メッセージ（messages/{messageId}） =====
    // 読み取り：1対1は当事者（sender か receiver が自分の名前）だけ。グループはそのグループのメンバーだけ
    // 作成：送信者が自分（senderUid が自分・sender が自分の名前）。グループはメンバーのときだけ
    // 更新：リアクションは当事者・メンバー、送信取り消し（soft delete）は送信者だけ
    // 削除（完全削除）：グループの管理者だけ（グループ削除のときにメッセージも消す）
    match /messages/{messageId} {
      allow read: if signedIn() && isMessageParticipant(resource.data);

      allow create: if signedIn()
        && request.resource.data.get('senderUid', '') == request.auth.uid
        && myName() != '' && request.resource.data.get('sender', '') == myName()
        && (
          request.resource.data.get('groupId', '') == ''
          || (myName() in groupMembers(request.resource.data.get('groupId', '')))
        );

      allow update: if signedIn() && (
        (isOwnMessage(resource.data) && deletedFieldsOnly())
        || (isMessageParticipant(resource.data) && reactionsFieldsOnly())
      );

      allow delete: if signedIn()
        && resource.data.get('groupId', '') != ''
        && (isGroupOwnerOf(resource.data.get('groupId', '')) || isSoleGroupMemberOf(resource.data.get('groupId', '')));

      function isOwnMessage(m) {
        return m.get('senderUid', '') == request.auth.uid
          || (m.get('senderUid', '') == '' && myName() != '' && m.get('sender', '') == myName());
      }
      function isMessageParticipant(m) {
        return (myName() != '' && (m.get('sender', '') == myName() || m.get('receiver', '') == myName()))
          || (m.get('groupId', '') != '' && myName() != '' && myName() in groupMembers(m.get('groupId', '')));
      }
      function deletedFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'image']);
      }
      function reactionsFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      }
      function groupPath(gid) {
        return /databases/$(database)/documents/groups/$(gid);
      }
      function groupMembers(gid) {
        return gid != '' && exists(groupPath(gid)) ? get(groupPath(gid)).data.get('members', []) : [];
      }
      function isGroupOwnerOf(gid) {
        return gid != '' && exists(groupPath(gid)) && (
          get(groupPath(gid)).data.get('ownerUid', '') == request.auth.uid
          || (get(groupPath(gid)).data.get('ownerUid', '') == '' && myName() != '' && get(groupPath(gid)).data.get('owner', '') == myName())
        );
      }
      // 最後の1人（自分だけがメンバー）のグループのメッセージは、グループを閉じるときに消せる
      function isSoleGroupMemberOf(gid) {
        return gid != '' && myName() != '' && exists(groupPath(gid)) && get(groupPath(gid)).data.get('members', []).hasOnly([myName()]);
      }
    }

    // ===== 通知トークン（fcmTokens/{token}） =====
    // アプリからは読まない（通知サーバー・GitHub Actions がサービスアカウントで読む）。
    // 作成・更新：自分の UID のトークンだけ（他人の UID で登録できない）。削除：自分の UID のトークンだけ
    match /fcmTokens/{token} {
      allow read: if false;
      allow create, update: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid;
      allow delete: if signedIn() && resource.data.get('uid', '') == request.auth.uid;
    }

    // ===== 🎰 ゆうスロの着席（yuslotSeats/{台ID}） =====
    // 予約・解放・更新は通知 Worker（サービスアカウント）だけ。ブラウザからは読み書きできない
    // （着席状況はアプリが Worker 経由で取得する。ブラウザが直接いじって不正着席・他人の解放をできないようにする）
    match /yuslotSeats/{machineId} {
      allow read: if false;
    }

    // ===== 🎟 ゆう宝くじ売り場（lotteryEntries／lotteryRounds） =====
    // 購入・抽選・支払いは通知 Worker（サービスアカウント）だけ。ブラウザからは読み書きできない
    // （誰がいくつ買ったか・抽選の中身を直接いじったり覗いたりできないように。アプリは Worker 経由で表示する）
    match /lotteryEntries/{entryId} {
      allow read: if false;
    }
    match /lotteryRounds/{roundId} {
      allow read: if false;
    }

    // ============================================================
    // 第3段階：ゲーム・ユーザー作成
    // ============================================================

    // ===== ゲームルーム（gameRooms/{roomId}） =====
    // 読み取り：ログイン済みなら誰でも（ロビー表示・観戦）
    // 作成：作成者が自分（ownerUid が自分・memberUids が自分だけ）
    // 更新：参加者（memberUids に自分）／新しく参加する人（自分を memberUids に加える）／
    //       招待された人が invitedUsers から自分だけを外す（辞退・参加の後始末）
    // 削除：作成者、または最後の1人（memberUids が自分だけ）のとき
    match /gameRooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('memberUids', []).hasOnly([request.auth.uid]);

      allow update: if signedIn() && (
        (request.auth.uid in resource.data.get('memberUids', []))
        || isJoiningGameRoom()
        || invitedSelfRemoveOnly()
      );

      allow delete: if signedIn() && (
        isGameRoomOwner(resource.data)
        || resource.data.get('memberUids', []).hasOnly([request.auth.uid])
      );

      function isGameRoomOwner(r) {
        return r.get('ownerUid', '') == request.auth.uid
          || (r.get('ownerUid', '') == '' && myName() != '' && r.get('owner', '') == myName());
      }
      // 新しく参加する人：自分を memberUids に加えるだけ（他の参加者は名前・UID とも減らさない）
      function isJoiningGameRoom() {
        return request.auth.uid in request.resource.data.get('memberUids', [])
          && !(request.auth.uid in resource.data.get('memberUids', []))
          && request.resource.data.get('memberUids', []).hasAll(resource.data.get('memberUids', []))
          && request.resource.data.get('members', []).hasAll(resource.data.get('members', []));
      }
      // 招待された人：invitedUsers から自分の名前だけを外す（参加者の構成やゲームの状態は変えない）
      function invitedSelfRemoveOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedUsers', 'updatedAt'])
          && myName() != '' && myName() in resource.data.get('invitedUsers', [])
          && !(myName() in request.resource.data.get('invitedUsers', []))
          && resource.data.get('invitedUsers', []).hasAll(request.resource.data.get('invitedUsers', []));
      }
    }

    // ===== ゲームルーム作成の記録（gameRoomOwners/{uid}_{ゲーム}） =====
    // 「同じゲームのルームは1人1個まで」を守るための記録。自分の UID の記録だけ読み書きできる
    match /gameRoomOwners/{lockId} {
      allow read: if signedIn() && (resource == null || resource.data.get('uid', '') == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid;
      allow delete: if signedIn() && resource.data.get('uid', '') == request.auth.uid;
    }

    // ===== ゲームの招待（gameInvites/{roomId}_{招待相手のuid}） =====
    // 読み取り：送った人（fromUid）か送られた人（toUid）だけ
    // 作成：送り主が自分（fromUid が自分）で、はじめは pending
    // 更新・削除：当事者（fromUid か toUid が自分）だけ
    match /gameInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.get('toUid', '') == request.auth.uid || resource.data.get('fromUid', '') == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending';
      allow update, delete: if signedIn()
        && (resource.data.get('toUid', '') == request.auth.uid || resource.data.get('fromUid', '') == request.auth.uid);
    }
  }
}
